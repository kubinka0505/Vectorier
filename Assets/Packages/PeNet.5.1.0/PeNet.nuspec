<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>PeNet</id>
    <version>5.1.0</version>
    <authors>Stefan Hausotte</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>icon.png</icon>
    <projectUrl>https://github.com/secana/PeNet</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/secana/PeNet/master/resource/icon.png</iconUrl>
    <description>PeNet is a Windows PE (Portable Executable) parser written in C#. It parses all PE
      header structures for x32 and x64.</description>
    <copyright>2017 @ Stefan Hausotte</copyright>
    <tags>PE Header Portable Executable</tags>
    <repository type="git" url="https://github.com/secana/PeNet" commit="e6e436158c06c8c35c7e52744ceb7de6cf20b5e6" />
    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <dependency id="PeNet.Asn1" version="2.0.1" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.0" exclude="Build,Analyzers" />
        <dependency id="System.Security.Cryptography.Pkcs" version="8.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="PeNet.Asn1" version="2.0.1" exclude="Build,Analyzers" />
        <dependency id="System.Security.Cryptography.Pkcs" version="8.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="PeNet.Asn1" version="2.0.1" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.0" exclude="Build,Analyzers" />
        <dependency id="System.Security.Cryptography.Pkcs" version="8.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="PeNet.Asn1" version="2.0.1" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.0" exclude="Build,Analyzers" />
        <dependency id="System.Security.Cryptography.Pkcs" version="8.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>