  <metadata>
    <id>PeNet.Asn1</id>
    <version>2.0.1</version>
    <authors>Sergey Savchuk, Jan Jansen, Stefan Hausotte</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>icon.png</icon>
    <projectUrl>https://github.com/secana/asn1</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/secana/PeNet/master/src/PEditor/Icons/logo.png</iconUrl>
    <description>Asn1 is a tool for parsing and formating ASN1 files.</description>
