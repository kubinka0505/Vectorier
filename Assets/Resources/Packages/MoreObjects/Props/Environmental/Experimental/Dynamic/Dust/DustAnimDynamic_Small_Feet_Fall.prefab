  Content: "<Init>\r\n\t<SetVariable Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable
    Name=\"$Node\" Value=\"NToe_1\"/>\r\n\t<SetVariable Name=\"$AI\" Value=\"0\"/>\r\n\t<SetVariable
    Name=\"Flag1\" Value=\"0\"/>\r\n</Init>\r\n<Loop Template=\"NoneType.Only\">\r\n\t<Conditions>\r\n\t\t<Operator
    Type=\"Or\">\r\n\t\t\t<Equal Value1=\"?getModel[_$Model].animationName\" Value2=\"LandingRoll\"/>\r\n\t\t\t<Equal
    Value1=\"?getModel[_$Model].animationName\" Value2=\"LandingLow\"/>\r\n\t\t\t<Equal
    Value1=\"?getModel[_$Model].animationName\" Value2=\"LandingMiddle\"/>\r\n\t\t\t<Equal
    Value1=\"?getModel[_$Model].animationName\" Value2=\"RunWallLanding\"/>\r\n\t\t\t<Equal
    Value1=\"?getModel[_$Model].animationName\" Value2=\"FastRunLanding\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n</Loop>"
