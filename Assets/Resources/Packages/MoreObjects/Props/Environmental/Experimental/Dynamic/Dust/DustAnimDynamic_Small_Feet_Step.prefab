--- !u!114 &1298618411202068264
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3455103350944893762}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6efe946d935848142abaa5de3f808a65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Content: "<Init>\r\n\t<SetVariable Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable
    Name=\"$Node\" Value=\"NToe_1\"/>\r\n\t<SetVariable Name=\"$AI\" Value=\"-1\"/>\r\n\t<SetVariable
    Name=\"Flag1\" Value=\"0\"/>\r\n</Init>\r\n<Loop Template=\"NoneType.Only\">\r\n\t<Conditions>\r\n\t\t<Operator
    Type=\"Or\">\r\n\t\t\t<Equal Value1=\"?getModel[_$Model].animationName\" Value2=\"RunForward\"/>\r\n\t\t\t<Equal
    Value1=\"?getModel[_$Model].animationName\" Value2=\"RunFast\"/>\r\n\t\t\t<Equal
    Value1=\"?getModel[_$Model].animationName\" Value2=\"RunReverse\"/>\r\n\t\t\t<Equal
    Value1=\"?getModel[_$Model].animationName\" Value2=\"RunInhibition\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n</Loop>"
