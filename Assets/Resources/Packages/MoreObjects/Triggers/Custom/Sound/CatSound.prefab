  m_Script: {fileID: 11500000, guid: 6efe946d935848142abaa5de3f808a65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Content: "<Init>\r\n\t<SetVariable Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable
    Name=\"$AI\" Value=\"0\"/>\r\n\t<SetVariable Name=\"$Node\" Value=\"COM\"/>\r\n\t<SetVariable
    Name=\"1Sound\" Value=\"_cs/k0505/cat_meow1\"/>\r\n\t<SetVariable Name=\"2Sound\"
    Value=\"_cs/k0505/cat_meow2\"/>\r\n\t<SetVariable Name=\"3Sound\" Value=\"_cs/k0505/cat_meow3\"/>\r\n\t<SetVariable
    Name=\"4Sound\" Value=\"_cs/k0505/cat_hiss1\"/>\r\n\t<SetVariable Name=\"5Sound\"
    Value=\"_cs/k0505/cat_hiss2\"/>\r\n\t<SetVariable Name=\"6Sound\" Value=\"_cs/k0505/cat_hiss3\"/>\r\n\t<SetVariable
    Name=\"Flag1\" Value=\"1\"/>\r\n</Init>\r\n<Loop>\r\n\t<Events Template=\"FreqUsed.OnShow\"/>\r\n\t<Actions>\r\n\t\t<Choose
    Order=\"Random\" Set=\"1\">\r\n\t\t\t<ActionBlock Template=\"CommonLib.Sound\"
    Prefix=\"1\"/>\r\n\t\t\t<ActionBlock Template=\"CommonLib.Sound\" Prefix=\"2\"/>\r\n\t\t\t<ActionBlock
    Template=\"CommonLib.Sound\" Prefix=\"3\"/>\r\n\t\t</Choose>\r\n\t</Actions>\r\n</Loop>\r\n<Loop>\r\n\t<Events
    Template=\"FreqUsed.OnHide\"/>\r\n\t<Actions>\r\n\t\t<Choose Order=\"Random\"
    Set=\"1\">\r\n\t\t\t<ActionBlock Template=\"CommonLib.Sound\" Prefix=\"4\"/>\r\n\t\t\t<ActionBlock
    Template=\"CommonLib.Sound\" Prefix=\"5\"/>\r\n\t\t\t<ActionBlock Template=\"CommonLib.Sound\"
    Prefix=\"6\"/>\r\n\t\t</Choose>\r\n\t</Actions>\r\n</Loop>"
