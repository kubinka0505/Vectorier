--- !u!114 &5813871839091673607
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5056670958749057472}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6efe946d935848142abaa5de3f808a65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Content: "<Init>\r\n\t<SetVariable Name=\"$AI\" Value=\"-1\"/>\r\n\t<SetVariable
    Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable Name=\"$Node\" Value=\"COM\"/>\r\n\t<SetVariable
    Name=\"AnimationName\" Value=\"CollisionAndRoll\"/>\r\n\t<SetVariable Name=\"AnimationFrame\"
    Value=\"14\"/>\r\n</Init>\r\n<Loop>\r\n\t<Events Template=\"FreqUsed.Exit\"/>\r\n\t<Conditions>\r\n\t\t<Equal
    Value1=\"?getModel[_$Model].animationName\" Value2=\"RunForward\"/>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<ForceAnimation
    Name=\"_AnimationName\" Frame=\"_AnimationFrame\" Model=\"_$Model\"/>\r\n\t</Actions>\r\n</Loop>"
