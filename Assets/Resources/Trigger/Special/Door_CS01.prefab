  m_Name: 
  m_EditorClassIdentifier: 
  Content: "<Init>\r\n\t<SetVariable Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable
    Name=\"$AI\" Value=\"2\"/>\r\n\t<SetVariable Name=\"$Node\" Value=\"COM\"/>\r\n\t<SetVariable
    Name=\"Sound\" Value=\"door_close\"/>\r\n\t<SetVariable Name=\"AnimName\" Value=\"Door\"/>\r\n\t<SetVariable
