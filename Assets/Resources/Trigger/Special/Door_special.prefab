  m_Script: {fileID: 11500000, guid: 6efe946d935848142abaa5de3f808a65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Content: "<Init>\r\n\t<SetVariable Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable
    Name=\"$AI\" Value=\"0\"/>\r\n\t<SetVariable Name=\"$Node\" Value=\"COM\"/>\r\n\t<SetVariable
    Name=\"Sound\" Value=\"door_close\"/>\r\n\t<SetVariable Name=\"AnimName\" Value=\"Door\"/>\r\n\t<SetVariable
    Name=\"AnimFrame\" Value=\"1\"/>\r\n\t<SetVariable Name=\"Flag1\" Value=\"0\"/>\r\n</Init>\r\n<Loop>\r\n\t<Events>\r\n\t\t<EventBlock
    Template=\"ModelAnimation.Only\"/>\r\n\t\t<EventBlock Template=\"CommonLib.ActiveDeath\"/>\r\n\t</Events>\r\n\t<Actions>\r\n\t\t<ActionBlock
    Template=\"ModelAnimation.Only\"/>\r\n\t\t<ActionBlock Template=\"CommonLib.Sound\"/>\r\n\t</Actions>\r\n</Loop>"
