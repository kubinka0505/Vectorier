--- !u!114 &7332126416787423092
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 841024827160133335}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6efe946d935848142abaa5de3f808a65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Content: "<Init>\r\n\t<SetVariable Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable
    Name=\"$AI\" Value=\"5\"/>\r\n\t<SetVariable Name=\"Sound\" Value=\"door_close\"/>\r\n\t<SetVariable
    Name=\"$Node\" Value=\"COM\"/>\r\n\t<SetVariable Name=\"Flag1\" Value=\"0\"/>\r\n</Init>\r\n<Loop>\r\n\t<Events>\r\n\t\t<Enter/>\r\n\t</Events>\r\n\t<Actions>\r\n\t\t<ActionBlock
    Template=\"CommonLib.Sound\"/>\r\n\t\t<EndGame Result=\"Loss\" Model=\"Hunter\"
    Frames=\"60\"/>\r\n\t\t<Control Switch=\"Off\" Model=\"Hunter\"/>\r\n\t\t<SetVariable
    Name=\"$Active\" Value=\"0\"/>\r\n\t\t<Choose Order=\"Sync\" Set=\"0\">\r\n\t\t\t<Transform
    Name=\"Transform_door_huntermode_platform\"/>\r\n\t\t\t<Transform Name=\"Transform_door_huntermode_image\"/>\r\n\t\t</Choose>\r\n\t</Actions>\r\n</Loop>"
