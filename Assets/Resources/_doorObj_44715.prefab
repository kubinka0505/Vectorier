--- !u!114 &4821168681915069084
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2511000745226064907}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6efe946d935848142abaa5de3f808a65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Content: "<Init>\r\n\t<SetVariable Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable
    Name=\"$AI\" Value=\"0\"/>\r\n\t<SetVariable Name=\"$Node\" Value=\"COM\"/>\r\n\t<SetVariable
    Name=\"1Sound\" Value=\"_cs/k0505/door_slam1\"/>\r\n\t<SetVariable Name=\"2Sound\"
    Value=\"_cs/k0505/door_slam2\"/>\r\n\t<SetVariable Name=\"Sound\" Value=\"_cs/k0505/door_break1\"/>\r\n\t<SetVariable
    Name=\"Flag1\" Value=\"1\"/>\r\n</Init>\r\n<Loop>\r\n\t<Events Template=\"FreqUsed.OnShow\"/>\r\n\t<Actions>\r\n\t\t<Choose
    Order=\"Random\" Set=\"1\">\n\t\t\t<ActionBlock Template=\"CommonLib.Sound\"
    Prefix=\"1\"/>\r\n\t\t\t<ActionBlock Template=\"CommonLib.Sound\" Prefix=\"2\"/>\r\n\t\t</Choose>\r\n\t</Actions>\r\n</Loop>\r\n<Loop>\r\n\t<Events
    Template=\"FreqUsed.OnHide\"/>\r\n\t<Sound Name=\"_Sound\"/>\r\n</Loop>"
