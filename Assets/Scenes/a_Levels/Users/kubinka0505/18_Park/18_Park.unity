  m_Script: {fileID: 11500000, guid: 6efe946d935848142abaa5de3f808a65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Content: "<Init>\r\n\t<SetVariable Name=\"$AI\" Value=\"0\"/>\r\n\t<SetVariable
    Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable Name=\"$Node\" Value=\"COM\"/>\r\n\t<SetVariable
    Name=\"Key\" Value=\"-1\"/>\r\n\t<SetVariable Name=\"TransformName\" Value=\"0\"/>\r\n</Init>\r\n<Loop>\r\n\t<Events
    Template=\"FreqUsed.KeyPressed\"/>\r\n\t<Conditions>\r\n\t\t<Operator Type=\"Or\">\r\n\t\t\t<Equal
    Value1=\"_$Key\" Value2=\"_Key\"/>\r\n\t\t\t<Equal Value1=\"_Key\" Value2=\"-1\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<ActionBlock
    Template=\"FreqUsed.SwitchOff\"/>\r\n\t\t<Transform Name=\"_TransformName\"/>\r\n\t</Actions>\r\n</Loop>"
