--- !u!114 &634128326
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 634128324}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6efe946d935848142abaa5de3f808a65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Content: "<Init>\r\n\t<SetVariable Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable
    Name=\"$Node\" Value=\"COM\"/>\r\n\t<SetVariable Name=\"$AI\" Value=\"0\"/>\r\n\t<SetVariable
    Name=\"Activator\" Value=\"UniqueStringOnly\"/>\r\n\t<SetVariable Name=\"Sound\"
    Value=\"_cs/k0505/helicopter_loop1\"/>\r\n\t<SetVariable Name=\"Flag1\" Value=\"0\"/>\r\n\t<SetVariable
    Name=\"Frames\" Value=\"200\"/>\r\n</Init>\r\n<Loop>\r\n\t<Events Template=\"FreqUsed.Enter\"/>\r\n\t<Actions
    Template=\"FreqUsed.DispatchEvent\"/>\r\n</Loop>\r\n<Loop Name=\"Recursion\">\r\n\t<Events
    Template=\"FreqUsed.Activate\"/>\r\n\t<Conditions>\r\n\t\t<Operator Type=\"And\">\r\n\t\t\t<Equal
    Value1=\"_$ActionID\" Value2=\"_Activator\"/>\r\n\t\t\t<Equal Value1=\"_Flag1\"
    Value2=\"0\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<Wait
    Frames=\"_Frames\"/>\r\n\t\t<Activate ActionID=\"_Activator\"/>\r\n\t</Actions>\r\n</Loop>\r\n<Loop>\r\n\t<Events
    Template=\"FreqUsed.Exit\"/>\r\n\t<Actions>\r\n\t\t<SetVariable Name=\"Flag1\"
    Value=\"1\"/>\r\n\t</Actions>\r\n</Loop>"
