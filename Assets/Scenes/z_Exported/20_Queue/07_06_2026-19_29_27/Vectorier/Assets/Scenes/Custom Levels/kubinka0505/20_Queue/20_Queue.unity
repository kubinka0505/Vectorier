  Content: "<Init>\r\n\t<SetVariable Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable
    Name=\"$Node\" Value=\"COM\"/>\r\n\t<SetVariable Name=\"$AI\" Value=\"0\"/>\r\n\t<SetVariable
    Name=\"Flag1\" Value=\"0\"/>\r\n</Init>\r\n<Loop>\r\n\t<Events Template=\"FreqUsed.Enter\"/>\r\n\t<Actions>\r\n\t\t<Choose
    Order=\"Sync\">\n\t\t\t<Choose Order=\"Random\" Set=\"1\">\n\t\t\t\t<Wait Frames=\"0\"/>\r\n\t\t\t\t<Wait
    Frames=\"0\"/>\r\n\t\t\t\t<Wait Frames=\"0\"/>\r\n\t\t\t\t<Wait Frames=\"0\"/>\r\n\t\t\t\t<Sound
    Name=\"glass_break\"/>\r\n\t\t\t</Choose>\r\n\t\t\t<Choose Order=\"Random\" Set=\"1\">\n\t\t\t\t<Wait
    Frames=\"0\"/>\r\n\t\t\t\t<Wait Frames=\"0\"/>\r\n\t\t\t\t<Sound Name=\"glass_item_drop1\"/>\r\n\t\t\t\t<Sound
    Name=\"glass_item_drop2\"/>\r\n\t\t\t\t<Sound Name=\"glass_item_drop3\"/>\r\n\t\t\t</Choose>\r\n\t\t\t<Choose
    Order=\"Random\" Set=\"1\">\n\t\t\t\t<Sound Name=\"cs/k0505/weapons/guns/tiny_one_1_1\"/>\r\n\t\t\t\t<Sound
    Name=\"cs/k0505/weapons/guns/tiny_one_1_2\"/>\r\n\t\t\t\t<Sound Name=\"cs/k0505/weapons/guns/tiny_one_1_3\"/>\r\n\t\t\t\t<Sound
    Name=\"cs/k0505/weapons/guns/tiny_one_1_4\"/>\r\n\t\t\t\t<Sound Name=\"cs/k0505/weapons/guns/tiny_one_2_1\"/>\r\n\t\t\t\t<Sound
    Name=\"cs/k0505/weapons/guns/tiny_one_2_2\"/>\r\n\t\t\t\t<Sound Name=\"cs/k0505/weapons/guns/tiny_one_2_3\"/>\r\n\t\t\t\t<Sound
    Name=\"cs/k0505/weapons/guns/tiny_one_3_1\"/>\r\n\t\t\t\t<Sound Name=\"cs/k0505/weapons/guns/tiny_one_4_1\"/>\r\n\t\t\t\t<Sound
    Name=\"cs/k0505/weapons/guns/tiny_one_4_2\"/>\r\n\t\t\t</Choose>\r\n\t\t</Choose>\r\n\t</Actions>\r\n</Loop>"
