--- !u!1001 &765800464
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 889086979}
    m_Modifications:
    - target: {fileID: 26039059538571145, guid: cf7373df3c068ea449c53772e8b5c6e4, type: 3}
      propertyPath: Content
      value: "<Init>\r\n\t<SetVariable Name=\"$Active\" Value=\"1\"/>\r\n\t<SetVariable
        Name=\"$AI\" Value=\"0\"/>\r\n\t<SetVariable Name=\"$Node\" Value=\"COM\"/>\r\n\t<SetVariable
        Name=\"FollowNode\" Value=\"Camera\"/>\r\n\t\r\n\t<!-- Initial Position Is
        a World Position or Current Player Position-->\r\n\t<SetVariable Name=\"InitialXPos\"
        Value=\"CurrentModel\"/>\r\n\t\r\n\t<!-- Unique String per Trigger -->\r\n\t<SetVariable
        Name=\"UniqueID\" Value=\"A3\"/>\r\n\t\r\n\t<SetVariable Name=\"UpdateEveryFrame\"
        Value=\"1\"/>\r\n\t\r\n\t<!-- I recommend not touching these-->\r\n\t<SetVariable
        Name=\"ActivatorToStart\" Value=\"ID\"/>\r\n\t<SetVariable Name=\"ActivatorToLoop\"
        Value=\"ID1\"/>\r\n\t<SetVariable Name=\"ActivatorToToggle\" Value=\"ID2\"/>\r\n\t<SetVariable
        Name=\"ActivatorToCheck\" Value=\"ID3\"/>\r\n\t\r\n\t<!-- The amount of Movement
        Every Transformation Does -->\r\n\t<!-- For this case, Move X is 25, and
        -25-->\r\n\t<SetVariable Name=\"MovementUnits\" Value=\"25\"/>\r\n\t<SetVariable
        Name=\"NegativeMovementUnits\" Value=\"-25\"/>\r\n\t\r\n\t<!-- Transformation
        Names for Moving Forward and Back-->\r\n\t<SetVariable Name=\"TransformForward\"
        Value=\"Right\"/>\r\n\t<SetVariable Name=\"TransformBack\" Value=\"Left\"/>\r\n\t\r\n\t<!--
        Model to Log Position-->\r\n\t<SetVariable Name=\"Model\" Value=\"Player\"/>\r\n\t\r\n\t<!--
        More things to Not Touch-->\r\n\t<SetVariable Name=\"Flag1\" Value=\"0\"/>\r\n\t<SetVariable
        Name=\"Flag2\" Value=\"0\"/>\r\n\t<SetVariable Name=\"State\" Value=\"RunForward\"/>\r\n\t<SetVariable
        Name=\"StateBuffer\" Value=\"0\"/>\r\n</Init>\r\n<Loop Name=\"PreProcess\">\r\n\t<Events>\r\n\t\t<Enter/>\r\n\t</Events>\r\n\t<Conditions>\r\n\t\t<Equal
        Value1=\"_InitialXPos\" Value2=\"CurrentModel\"/>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<SetVariable
        Name=\"Model\" Value=\"_$Model\"/>\r\n\t\t<SetVariable Name=\"InitialXPos\"
        Value=\"?getModel[_Model].getNode[_FollowNode].worldPositionX\"/>\r\n\t</Actions>\r\n</Loop>\r\n<Loop
        Name=\"Start\">\r\n\t<Events>\r\n\t\t<Enter/>\r\n\t</Events>\r\n\t<Conditions>\r\n\t\t<Equal
        Value1=\"_Flag2\" Value2=\"0\"/>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<SetVariable
        Name=\"Flag1\" Value=\"1\"/>\r\n\t\t<SetVariable Name=\"Flag2\" Value=\"1\"/>\r\n\t\t<SetVariable
        Name=\"Model\" Value=\"_$Model\"/>\r\n\t\t<AppendValue Name=\"ActivatorToStart\"
        Value=\"_UniqueID\"/>\r\n\t\t<AppendValue Name=\"ActivatorToLoop\" Value=\"_UniqueID\"/>\r\n\t\t<AppendValue
        Name=\"ActivatorToToggle\" Value=\"_UniqueID\"/>\r\n\t\t<AppendValue Name=\"ActivatorToCheck\"
        Value=\"_UniqueID\"/>\r\n\t\t<Activate ActionID=\"_ActivatorToStart\"/>\r\n\t</Actions>\r\n</Loop>\r\n<Loop
        Name=\"UpdateInitialXPos\">\r\n\t<Events>\r\n\t\t<Activate/>\r\n\t</Events>\r\n\t<Conditions>\r\n\t\t<Operator
        Type=\"And\">\r\n\t\t\t<Equal Value1=\"_$ActionID\" Value2=\"_ActivatorToLoop\"/>\r\n\t\t\t<Equal
        Value1=\"_Flag1\" Value2=\"1\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<Activate
        ActionID=\"_ActivatorToStart\"/>\r\n\t</Actions>\r\n</Loop>\r\n<Loop Name=\"CheckIfInitialIsHigher\">\r\n\t<Events>\r\n\t\t<Activate/>\r\n\t</Events>\r\n\t<Conditions>\r\n\t\t<Operator
        Type=\"And\">\r\n\t\t\t<Equal Value1=\"_$ActionID\" Value2=\"_ActivatorToStart\"/>\r\n\t\t\t<Equal
        Value1=\"_Flag1\" Value2=\"1\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<Choose
        Order=\"Straight\">\r\n\t\t\t<Wait Frames=\"_UpdateEveryFrame\"/>\r\n\t\t\t<Activate
        ActionID=\"_ActivatorToCheck\"/>\r\n\t\t\t<Activate ActionID=\"_ActivatorToLoop\"/>\r\n\t\t</Choose>\r\n\t</Actions>\r\n</Loop>\r\n<Loop
        Name=\"CheckPositive\">\r\n\t<Events>\r\n\t\t<Activate/>\r\n\t</Events>\r\n\t<Conditions>\r\n\t\t<Operator
        Type=\"And\">\r\n\t\t\t<Greater Value=\"?getModel[_Model].getNode[_FollowNode].worldPositionX\"
        Than=\"_InitialXPos\"/>\r\n\t\t\t<Equal Value1=\"_$ActionID\" Value2=\"_ActivatorToCheck\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<Choose
        Order=\"Sync\">\r\n\t\t\t<AppendValue Name=\"InitialXPos\" Value=\"_MovementUnits\"/>\r\n\t\t\t<Transform
        Name=\"_TransformForward\"/>\r\n\t\t</Choose>\r\n\t</Actions>\r\n</Loop>\r\n<Loop
        Name=\"RunFastOffset\">\r\n\t<Events>\r\n\t\t<Activate/>\r\n\t</Events>\r\n\t<Conditions>\r\n\t\t<Operator
        Type=\"And\">\r\n\t\t\t<Operator Type=\"Or\">\r\n\t\t\t\t<Equal Value1=\"?getModel[_Model].animationName\"
        Value2=\"RunFastFromRun\"/>\r\n\t\t\t\t<Equal Value1=\"?getModel[_Model].animationName\"
        Value2=\"RunFastJump\"/>\r\n\t\t\t\t<Equal Value1=\"?getModel[_Model].animationName\"
        Value2=\"RunFastFly\"/>\r\n\t\t\t\t<Equal Value1=\"?getModel[_Model].animationName\"
        Value2=\"RunFastFall\"/>\r\n\t\t\t</Operator>\r\n\t\t\t<Equal Value1=\"_$ActionID\"
        Value2=\"_ActivatorToCheck\"/>\r\n\t\t\t<Equal Value1=\"_State\" Value2=\"None\"
        Not=\"1\"/>\r\n\t\t\t<Equal Value1=\"_StateBuffer\" Value2=\"0\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<SetVariable
        Name=\"State\" Value=\"None\"/>\r\n\t\t<Wait Frames=\"20\"/>\r\n\t\t<AppendValue
        Name=\"InitialXPos\" Value=\"-130\"/>\r\n\t\t<SetVariable Name=\"StateBuffer\"
        Value=\"1\"/>\r\n\t</Actions>\r\n</Loop>\r\n<Loop Name=\"DefaultOffset\">\r\n\t<Events>\r\n\t\t<Activate/>\r\n\t</Events>\r\n\t<Conditions>\r\n\t\t<Operator
        Type=\"And\">\r\n\t\t\t<Operator Type=\"And\">\r\n\t\t\t\t<Equal Value1=\"?getModel[_Model].animationName\"
        Value2=\"RunFastFromRun\" Not=\"1\"/>\r\n\t\t\t\t<Equal Value1=\"?getModel[_Model].animationName\"
        Value2=\"RunFast\" Not=\"1\"/>\r\n\t\t\t\t<Equal Value1=\"?getModel[_Model].animationName\"
        Value2=\"RunFastJump\" Not=\"1\"/>\r\n\t\t\t\t<Equal Value1=\"?getModel[_Model].animationName\"
        Value2=\"RunFastFly\" Not=\"1\"/>\r\n\t\t\t\t<Equal Value1=\"?getModel[_Model].animationName\"
        Value2=\"RunFastFall\" Not=\"1\"/>\r\n\t\t\t</Operator>\r\n\t\t\t<Equal Value1=\"_$ActionID\"
        Value2=\"_ActivatorToCheck\"/>\r\n\t\t\t<Equal Value1=\"_StateBuffer\" Value2=\"1\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<SetVariable
        Name=\"State\" Value=\"RunForward\"/>\r\n\t\t<AppendValue Name=\"InitialXPos\"
        Value=\"130\"/>\r\n\t\t<SetVariable Name=\"StateBuffer\" Value=\"0\"/>\r\n\t</Actions>\r\n</Loop>\r\n<Loop
        Name=\"CheckNegative\">\r\n\t<Events>\r\n\t\t<Activate/>\r\n\t</Events>\r\n\t<Conditions>\r\n\t\t<Operator
        Type=\"And\">\r\n\t\t\t<Less Value=\"?getModel[_Model].getNode[_FollowNode].worldPositionX\"
        Than=\"_InitialXPos\"/>\r\n\t\t\t<Equal Value1=\"_$ActionID\" Value2=\"_ActivatorToCheck\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<Choose
        Order=\"Sync\">\r\n\t\t\t<AppendValue Name=\"InitialXPos\" Value=\"_NegativeMovementUnits\"/>\r\n\t\t\t<Transform
        Name=\"_TransformBack\"/>\r\n\t\t</Choose>\r\n\t</Actions>\r\n</Loop>\r\n<Loop
        Name=\"ToggleOn\">\r\n\t<Using>\r\n\t\t<Variable Name=\"ActivatorToToggle\"
        DefaultValue=\"0\" Type=\"String\"/>\r\n\t</Using>\r\n\t<Events>\r\n\t\t<Activate/>\r\n\t</Events>\r\n\t<Conditions>\r\n\t\t<Operator
        Type=\"And\">\r\n\t\t\t<Equal Value1=\"_$ActionID\" Value2=\"_ActivatorToToggle\"/>\r\n\t\t\t<Equal
        Value1=\"_Flag1\" Value2=\"0\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<SetVariable
        Name=\"Flag1\" Value=\"1\"/>\r\n\t\t<Activate ActionID=\"_ActivatorToLoop\"/>\r\n\t</Actions>\r\n</Loop>\r\n<Loop
        Name=\"ToggleOff\">\r\n\t<Using>\r\n\t\t<Variable Name=\"ActivatorToToggle\"
        DefaultValue=\"0\" Type=\"String\"/>\r\n\t</Using>\r\n\t<Events>\r\n\t\t<Activate/>\r\n\t</Events>\r\n\t<Conditions>\r\n\t\t<Operator
        Type=\"And\">\r\n\t\t\t<Equal Value1=\"_$ActionID\" Value2=\"_ActivatorToToggle\"/>\r\n\t\t\t<Equal
        Value1=\"_Flag1\" Value2=\"1\"/>\r\n\t\t</Operator>\r\n\t</Conditions>\r\n\t<Actions>\r\n\t\t<SetVariable
        Name=\"Flag1\" Value=\"0\"/>\r\n\t</Actions>\r\n</Loop>"
      objectReference: {fileID: 0}
    - target: {fileID: 8790972765119806661, guid: cf7373df3c068ea449c53772e8b5c6e4, type: 3}
